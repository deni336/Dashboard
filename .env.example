DENILICENSE_API_URL=http://denilicense-api:8080
DENILICENSE_ISSUER=http://127.0.0.1:8080
DENILICENSE_PRODUCT_CODE=KASUGAI
DENILICENSE_ACTIVATION_LABEL=Kasugai Dashboard
KASUGAI_PUBLIC_URL=
KASUGAI_DASHBOARD_BIND_HOST=127.0.0.1
KASUGAI_TRUST_PROXY=false
KASUGAI_SESSION_COOKIE_SECURE=
# Dashboard-only Compose requires KASUGAI_SERVER_HOST. Leave these blank when
# using the combined stack, which wires its bundled kasugai-server internally.
KASUGAI_DASHBOARD_IMAGE=
KASUGAI_SERVER_HOST=
KASUGAI_SERVER_PORT=8008
KASUGAI_FILE_TRANSFER_HOST=
KASUGAI_FILE_TRANSFER_PORT=50051
KASUGAI_MEDIA_PORT=50052
# Core-only Compose leaves AI disabled. The Ollama overlay overrides these.
KASUGAI_AI_PROVIDER=disabled
KASUGAI_AI_BASE_URL=
KASUGAI_AI_MODEL=gpt-oss:20b
# Credential for an authenticated private/local OpenAI-compatible endpoint.
# This is not the hosted OpenAI fallback key. Prefer the _FILE form.
KASUGAI_AI_API_KEY=
KASUGAI_AI_API_KEY_FILE=
# Hosted OpenAI deployment fallback. Prefer a project service-account key and
# list every permitted user in KASUGAI_AI_ALLOWED_USERS; see docs/CREDENTIALS.md.
# Prefer the _FILE form.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
KASUGAI_AI_TIMEOUT_SECONDS=300
KASUGAI_AI_REQUEST_BUDGET_SECONDS=330
KASUGAI_AI_ALLOWED_USERS=
KASUGAI_AI_SOURCE_ALLOWED_USERS=
OLLAMA_IMAGE=ollama/ollama:0.31.2
OLLAMA_CONTEXT_LENGTH=32768
# Deployment source token for explicitly allowlisted GitHub repositories.
# See docs/CREDENTIALS.md for the distinct per-user notification token.
GITHUB_TOKEN=
GITHUB_TOKEN_FILE=
KASUGAI_GITHUB_TOKEN_ALLOWLIST=
# Developer Cockpit access is disabled only when this user allowlist is set and
# the signed-in DeniLicense profile does not match it.
KASUGAI_DEVELOPER_ALLOWED_USERS=
KASUGAI_REPOSITORY_ROOTS=
KASUGAI_REPOSITORY_ALLOWED_ROOTS=
# Used only with docker-compose.repositories.yml. Prefer a narrow projects
# folder, expressed with forward slashes on Windows (for example C:/Projects).
KASUGAI_REPOSITORY_HOST_PATH=
KASUGAI_WORKSTATION_ENABLED=true
KASUGAI_WORKSTATION_ALLOWED_USERS=
KASUGAI_WORKSTATION_RETENTION_HOURS=24
KASUGAI_WORKSTATION_MAX_AGENTS=8
KASUGAI_WORKSTATION_INTERVAL_SECONDS=10
KASUGAI_HOMELAB_ENABLED=true
KASUGAI_HOMELAB_ALLOWED_USERS=
KASUGAI_HOMELAB_MAX_AGENTS=8
KASUGAI_HOMELAB_INTERVAL_SECONDS=15
KASUGAI_HOMELAB_ACTION_POLL_SECONDS=5
KASUGAI_HOMELAB_SAMPLE_RETENTION_HOURS=168
# Remote Docker actions remain off unless the server administrator, host
# policy, and individual container labels all grant them.
KASUGAI_HOMELAB_ACTIONS_ENABLED=false
KASUGAI_LAUNCHER_ENABLED=true
KASUGAI_LAUNCHER_ALLOWED_USERS=
KASUGAI_LAUNCHER_MAX_AGENTS=8
KASUGAI_LAUNCHER_CATALOG_INTERVAL_SECONDS=30
KASUGAI_LAUNCHER_POLL_SECONDS=5
# Remote task delivery is deliberately opt-in. Task definitions still live only
# in the companion's local protected configuration.
KASUGAI_LAUNCHER_RUNS_ENABLED=false
KASUGAI_AUTOMATION_ENABLED=true
KASUGAI_AUTOMATION_ALLOWED_USERS=
KASUGAI_AUTOMATION_SCHEDULER_SECONDS=15
# Automatic delivery may target only locally approved launcher tasks that do
# not require confirmation. This second kill switch is off by default.
KASUGAI_AUTOMATION_TASKS_ENABLED=false
KASUGAI_INBOX_ENABLED=true
KASUGAI_INBOX_ALLOWED_USERS=
KASUGAI_KNOWLEDGE_ENABLED=true
KASUGAI_KNOWLEDGE_ALLOWED_USERS=
KASUGAI_SECURITY_ENABLED=true
KASUGAI_SECURITY_ALLOWED_USERS=
KASUGAI_AI_TOOLBOX_ENABLED=true
KASUGAI_AI_TOOLBOX_ALLOWED_USERS=
KASUGAI_PERSONAL_HUB_ENABLED=true
KASUGAI_PERSONAL_HUB_ALLOWED_USERS=
KASUGAI_IMAP_HOST=imap.gmail.com
KASUGAI_IMAP_PORT=993
KASUGAI_IMAP_USERNAME=
# For Gmail, create an app password at https://myaccount.google.com/apppasswords
# rather than entering the Google account password. Prefer the _FILE form.
KASUGAI_IMAP_PASSWORD=
KASUGAI_IMAP_PASSWORD_FILE=
